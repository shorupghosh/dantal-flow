# DentalFlow AI - Production & Live API Environment Variables
# Copy this file to '.env' and fill in your actual production API credentials.

# 1. Supabase Database & Auth (PostgreSQL)
VITE_SUPABASE_URL=https://gytottzymosgtsirugle.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Google Gemini API (AI Receptionist & Review Auto-Responder)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Resend Email API (Automated Email Notifications)
VITE_RESEND_API_KEY=your_resend_api_key_here

# 4. Twilio / SMS Notification API (Automated SMS Alerts)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
VITE_TWILIO_PHONE_NUMBER=your_twilio_phone_number
